#!/bin/bash
# RunPod operations: train / pull / promote / cost-report / ps / status /
# logs / watch / volume.
#
# Usage:
#   dev/runpod train <commit-sha> [--case caseN] [--cloud-type SECURE|COMMUNITY|ALL] [--watch]
#   dev/runpod pull <run_id> [--case caseN]
#   dev/runpod promote <run_id> [--case caseN] [--eval-results PATH]
#   dev/runpod cost-report [--month YYYY-MM]
#   dev/runpod ps [--case caseN] [--all]
#   dev/runpod status <run_id> [--case caseN]
#   dev/runpod logs <run_id> [--case caseN] [--source markers|onstart] [--tail N] [--grep PATTERN]
#   dev/runpod watch <run_id> [--case caseN] [--poll-interval 30] [--max-wait 7200]
#   dev/runpod volume {list|search|create} [...]
#
# `--watch` (or `dev/runpod watch <run_id>`) polls S3 progress markers and pod
# state until completion, then fires a desktop notification (macOS osascript /
# Linux notify-send / fallback echo). Use `dev/runpod logs <run_id>` to inspect
# the marker timeline after completion.
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run --directory backend python -m runpod_io "$@"
