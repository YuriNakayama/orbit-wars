# Vast.ai API key — get one at https://cloud.vast.ai/manage-keys/
# Used by `dev/vast train` to launch GPU instances.
VAST_API_KEY=

# RunPod API key — get one at https://runpod.io/console/user/settings
# Used by `dev/runpod train` to launch GPU pods.
RUNPOD_API_KEY=

# GitHub Personal Access Token (optional) — get one at https://github.com/settings/tokens
# Used by `dev/runpod train` だけ。pod 内で onstart の最終段に
# `<RUN_ID>.dvc` メタファイルを git commit + push するために必要。
# 未設定でも S3 fallback 経路で `dev/runpod pull` は動くが、DVC 経路の
# 正本化は完成しない。`repo` scope で発行。
GIT_PAT=

# Kaggle credentials are read from ~/.kaggle/kaggle.json
# AWS credentials for DVC remote are read from ~/.aws/credentials [orbit-wars]
