# Kaggle 提出アーカイブから除外するパス (pipeline/<category>/case*/ 配下すべてに適用)
# 書式: gitignore 互換 (行頭 # はコメント、空行は無視、末尾 / でディレクトリ指定、* は fnmatch)
# case_dir 相対パスで評価される。

# 開発ツール (本番提出に不要)
eda/
notebook/
evaluation/
training/
scripts/

# JAX 化エージェント / GPU ベンチ (学習・データ生成用、Kaggle submit 対象外)
baseline_jax/
baseline_jax_full/
_bench/

# ローカル参照用の config (baseline は定数として core/config.py に持つ)
configs/
