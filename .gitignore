# data — actual contents are DVC-managed; only stubs / docs land in git.
# Includes data/output/ (Vast.ai run outputs; see data/output/README.md).
# `/data` (worktree symlink to main repo's data/) is also untracked.
/data
/data/**
!/data/**/
!/data/**/*.dvc
!/data/**/.gitignore
!/data/**/*.md
!/data/**/.gitkeep
# .dvc ディレクトリの自動生成 .gitignore も拾えるようにする
!/data/.gitignore

# DVC
/.dvc/tmp
/.dvc/config.local
/.dvc/cache

# DVC-managed weights (formerly git-tracked)
backend/pipeline/imitation/case1/policy/weights.pt

# Terraform vars (contain secrets)
infra/**/terraform.tfvars

# kaggle credentials
.kaggle/
kaggle.json

# claude code scheduled tasks (local runtime state)
.claude/scheduled_tasks.lock

# skill-creator workspaces (per-skill eval outputs / benchmarks; reproducible)
.claude/skills/*-workspace/
